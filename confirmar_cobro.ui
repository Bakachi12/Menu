 <property name="styleSheet"><string>QWidget#DialogCobro {background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #111c2c,stop:0.55 #17243a,stop:1 #101929); border: 2px solid #52647a; border-radius: 26px;}
